      "id": "function-import-does-not-leak-to-sibling",
      "family": "python-import-symbol-scope",
      "class": "python-import-statement-scope",
      "split": "development",
      "command": "callees",
      "target": "handler",
      "symbol_names": "qualified",
      "files": {
        "service.py": "def helper(value):\n    return value\n",
        "other.py": "def helper(value):\n    return 0\n",
        "routes.py": "def loader():\n    from service import helper\n    return helper(0)\ndef handler(value):\n    return helper(value)\n"
      },
      "expected": {
        "symbols": [],
        "edges": [
          [
            "helper",
            false
          ]
        ],
        "endpoint_edges": [
          [
            [
              "routes.py",
              "handler"
            ],
            null,
            "helper",
            false
          ]
        ]
      }
    },
