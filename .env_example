# Sentinel AI configuration. Launch Sentinel from this directory.
# Terminal environment variables override values in this file.
# Paste your NVIDIA key below; never commit .env.
NVIDIA_API_KEY=
SENTINEL_LOCAL_ENDPOINT=http://localhost:1234/v1
SENTINEL_LOCAL_MODEL=qwen/qwen3.5-9b
SENTINEL_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
SENTINEL_NIM_MODEL=z-ai/glm-5.3
